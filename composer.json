{
    "name": "gembapay/gembapay-php",
    "description": "GembaPay PHP SDK — unified payment gateway for Stripe card payments and PayPal. Funds settle directly to the merchant.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "payments",
        "payment-gateway",
        "stripe",
        "paypal",
        "card-payments",
        "credit-card",
        "fiat-payments",
        "payment-processing",
        "checkout",
        "unified-checkout",
        "ecommerce",
        "gateway",
        "merchant",
        "laravel",
        "wordpress",
        "php-sdk"
    ],
    "homepage": "https://gembapay.com",
    "authors": [
        {
            "name": "GEMBA EOOD",
            "email": "contacts@gembapay.com",
            "homepage": "https://gembapay.com"
        }
    ],
    "support": {
        "email": "contacts@gembapay.com",
        "issues": "https://github.com/ivanovslavy/gembapay/issues",
        "source": "https://github.com/ivanovslavy/gembapay",
        "docs": "https://gembapay.com/docs"
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "GembaPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GembaPay\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
